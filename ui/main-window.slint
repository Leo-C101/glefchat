import { HorizontalBox, VerticalBox, LineEdit, Button, ScrollView } from "std-widgets.slint";
import { CatppuccinMocha } from "theme.slint";

export struct Message {
    content: string,
    timestamp: string,
    author: string,
}

export component MainWindow inherits Window {
    title: "GlefChat";
    width: 1280px;
    height: 780px;
    background: CatppuccinMocha.base;
    
    in-out property <[Message]> messages;
    in-out property <string> username: "";
    in-out property <bool> logged-in: false;
    in-out property <string> auth-error: "";
    callback send-message(string);
    callback login(string, string);
    callback register(string, string);
    callback log-out();
    
    if !root.logged-in : Rectangle {
        background: CatppuccinMocha.base;
        
        Rectangle {
            width: 380px;
            height: 320px;
            background: CatppuccinMocha.surface0;
            border-radius: 14px;
            
            VerticalBox {
                padding: 28px;
                spacing: 14px;
                alignment: center;
                
                Text {
                    text: "GlefChat";
                    font-size: 26px;
                    font-weight: 700;
                    color: CatppuccinMocha.lavender;
                    horizontal-alignment: center;
                }
                
                Text {
                    text: "Sign in or create a profile";
                    font-size: 13px;
                    color: CatppuccinMocha.subtext0;
                    horizontal-alignment: center;
                }
                
                username-input := LineEdit {
                    placeholder-text: "Username";
                }
                
                password-input := LineEdit {
                    placeholder-text: "Password";
                    input-type: password;
                    accepted(text) => {
                        root.login(username-input.text, text);
                    }
                }
                
                if root.auth-error != "" : Text {
                    text: root.auth-error;
                    font-size: 12px;
                    color: CatppuccinMocha.red;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                
                HorizontalBox {
                    Button {
                        text: "Log In";
                        primary: true;
                        clicked => {
                            root.login(username-input.text, password-input.text);
                        }
                    }
                    
                    Button {
                        text: "Register";
                        clicked => {
                            root.register(username-input.text, password-input.text);
                        }
                    }
                }
            }
        }
    }
    
    if root.logged-in : VerticalBox {
        padding: 20px;
        spacing: 16px;
        
        Rectangle {
            background: CatppuccinMocha.surface0;
            height: 60px;
            border-radius: 10px;
            
            HorizontalBox {
                padding-left: 14px;
                padding-right: 14px;
                
                Text {
                    text: "GlefChat";
                    font-size: 22px;
                    font-weight: 700;
                    color: CatppuccinMocha.lavender;
                    vertical-alignment: center;
                }
                
                Rectangle { }
                
                Text {
                    text: "Signed in as " + root.username;
                    font-size: 14px;
                    color: CatppuccinMocha.subtext0;
                    vertical-alignment: center;
                }
                
                Button {
                    text: "Log Out";
                    clicked => {
                        root.log-out();
                    }
                }
            }
        }
        
        Rectangle {
            background: CatppuccinMocha.surface0;
            border-radius: 10px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Rectangle {
                    background: CatppuccinMocha.mantle;
                    border-radius: 10px;
    
                    ScrollView {
                        VerticalBox {
                            padding: 12px;
                            spacing: 10px;
                            alignment: end;
                            
                            if root.messages.length == 0 : Text {
                                text: "No messages yet — say hello!";
                                font-size: 14px;
                                color: CatppuccinMocha.overlay0;
                                horizontal-alignment: center;
                            }
                            
                            for message[index] in root.messages : HorizontalBox {
                                padding: 0px;
                                alignment: message.author == root.username ? end : start;
                                
                                Rectangle {
                                    max-width: 700px;
                                    background: message.author == root.username ? CatppuccinMocha.mauve : CatppuccinMocha.surface1;
                                    border-radius: 14px;
                                    
                                    VerticalBox {
                                        padding: 10px;
                                        spacing: 3px;
                                        
                                        Text {
                                            text: message.author;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: message.author == root.username ? CatppuccinMocha.crust : CatppuccinMocha.lavender;
                                        }
                                        
                                        Text {
                                            text: message.content;
                                            font-size: 16px;
                                            wrap: word-wrap;
                                            color: message.author == root.username ? CatppuccinMocha.crust : CatppuccinMocha.text;
                                        }
                                        
                                        Text {
                                            text: message.timestamp;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                            color: message.author == root.username ? CatppuccinMocha.crust : CatppuccinMocha.subtext0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                Rectangle {
                    background: CatppuccinMocha.surface1;
                    height: 52px;
                    border-radius: 10px;

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        
                        input := LineEdit {
                            placeholder-text: "Type a message…";
                            accepted(text) => {
                                root.send-message(text);
                                self.text = "";
                            }
                        }

                        Button {
                            text: "Send";
                            enabled: input.text != "";
                            clicked => {
                                root.send-message(input.text);
                                input.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}