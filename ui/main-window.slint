import { HorizontalBox, VerticalBox, LineEdit, Button, ScrollView, ComboBox } from "std-widgets.slint";
export struct Message {
    content: string,
    timestamp: string,
    author: string,
    is-system: bool,
    profile-picture: image,
}

export struct ThemeColor {
    name: string,
    key: string,
    hex: string,
    value: color,
}

export struct ChannelView {
    id: string,
    name: string,
    topic: string,
}

component ChatScrollView inherits ScrollView {
    in property <int> scroll-request: 0;

    changed scroll-request => {
        root.content-y = root.content-height;
    }
}

export component MainWindow inherits Window {
    title: "GlefChat";
    preferred-width: 1280px;
    preferred-height: 780px;
    min-width: 760px;
    min-height: 560px;
    background: root.theme-colors[23].value;
    
    in-out property <[Message]> messages;
    in-out property <[ChannelView]> channels;
    in-out property <[string]> channel-names;
    in-out property <string> selected-channel-id: "";
    in-out property <string> selected-channel-name: "";
    in-out property <string> selected-channel-topic: "";
    in-out property <bool> channel-management-open: false;
    in-out property <string> username: "";
    in-out property <bool> logged-in: false;
    in-out property <bool> restoring-session: false;
    in-out property <string> auth-error: "";
    in-out property <[ThemeColor]> theme-colors;
    in-out property <[ThemeColor]> editable-theme-colors;
    in-out property <string> accent-name: "Lavender";
    in-out property <bool> theme-editor-open: false;
    in-out property <bool> profile-editor-open: false;
    in-out property <bool> viewed-profile-open: false;
    in-out property <bool> viewed-profile-loading: false;
    in-out property <string> viewed-profile-username: "";
    in-out property <string> account-role: "Member";
    in-out property <string> viewed-profile-role: "Member";
    in-out property <bool> viewed-profile-banned: false;
    in-out property <string> theme-error: "";
    in-out property <string> profile-error: "";
    in-out property <string> privilege-error: "";
    in-out property <image> profile-picture;
    in-out property <image> profile-banner;
    in-out property <image> viewed-profile-picture;
    in-out property <image> viewed-profile-banner;
    in-out property <bool> follow-chat-bottom: true;
    in-out property <int> chat-scroll-request: 0;
    callback send-message(string);
    callback select-channel(string);
    callback create-channel(string, string);
    callback edit-channel(string, string, string);
    callback login(string, string);
    callback register(string, string);
    callback log-out();
    callback set-theme-color(int, string);
    callback set-theme-accent(string);
    callback choose-profile-picture();
    callback choose-profile-banner();
    callback show-user-profile(string);
    callback set-user-role(string, string);
    callback set-user-banned(string, bool);
    
    if !root.logged-in : Rectangle {
        background: root.theme-colors[23].value;

        VerticalBox {
            alignment: center;

            if root.restoring-session : Text {
                text: "Restoring your session...";
                font-size: 16px;
                color: root.theme-colors[14].value;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if !root.restoring-session : HorizontalBox {
                alignment: center;

                Rectangle {
                    width: 380px;
                    height: 320px;
                    background: root.theme-colors[22].value;
                    border-radius: 14px;

                    VerticalBox {
                        padding: 28px;
                        spacing: 14px;
                        alignment: center;

                        Text {
                            text: "GlefChat";
                            font-size: 26px;
                            font-weight: 700;
                            color: root.theme-colors[13].value;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Sign in or create a profile";
                            font-size: 13px;
                            color: root.theme-colors[16].value;
                            horizontal-alignment: center;
                        }

                        username-input := LineEdit {
                            placeholder-text: "Username";
                        }

                        password-input := LineEdit {
                            placeholder-text: "Password";
                            input-type: password;
                            accepted(text) => {
                                root.login(username-input.text, text);
                            }
                        }

                        if root.auth-error != "" : Text {
                            text: root.auth-error;
                            font-size: 12px;
                            color: root.theme-colors[4].value;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalBox {
                            Button {
                                text: "Log In";
                                primary: true;
                                clicked => {
                                    root.login(username-input.text, password-input.text);
                                }
                            }

                            Button {
                                text: "Register";
                                clicked => {
                                    root.register(username-input.text, password-input.text);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    if root.logged-in : VerticalBox {
        padding: 18px;
        spacing: 14px;
        
        Rectangle {
            background: root.theme-colors[22].value;
            height: 64px;
            border-radius: 12px;
            
            HorizontalBox {
                padding-left: 14px;
                padding-right: 14px;
                
                Text {
                    text: "GlefChat";
                    font-size: 23px;
                    font-weight: 700;
                    color: root.theme-colors[13].value;
                    vertical-alignment: center;
                }
                
                Rectangle { }
                
                Text {
                    text: "Signed in as " + root.username + " (" + root.account-role + ")";
                    font-size: 13px;
                    color: root.theme-colors[16].value;
                    vertical-alignment: center;
                }
                
                Button {
                    text: "Theme";
                    clicked => {
                        root.viewed-profile-open = false;
                        root.profile-editor-open = false;
                        root.theme-editor-open = !root.theme-editor-open;
                        root.theme-error = "";
                    }
                }

                Button {
                    text: "Profile";
                    clicked => {
                        root.viewed-profile-open = false;
                        root.theme-editor-open = false;
                        root.profile-editor-open = !root.profile-editor-open;
                        root.profile-error = "";
                    }
                }

                Button {
                    text: "Log Out";
                    clicked => {
                        root.log-out();
                    }
                }
            }
        }

        if root.viewed-profile-open : Rectangle {
            height: root.account-role == "Admin" ? 190px : (root.account-role == "Moderator" ? 150px : 112px);
            background: root.theme-colors[22].value;
            border-radius: 12px;

            HorizontalBox {
                padding: 10px;
                spacing: 12px;

                Rectangle {
                    width: 180px;
                    height: 88px;
                    background: root.theme-colors[21].value;
                    border-radius: 8px;
                    clip: true;

                    Image {
                        source: root.viewed-profile-banner;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }

                Rectangle {
                    width: 64px;
                    height: 64px;
                    background: root.theme-colors[21].value;
                    border-radius: 32px;
                    clip: true;

                    Image {
                        source: root.viewed-profile-picture;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }

                VerticalBox {
                    alignment: center;

                    Text {
                        text: root.viewed-profile-username;
                        font-size: 18px;
                        font-weight: 700;
                        color: root.theme-colors[13].value;
                    }

                    Text {
                        text: "Role: " + root.viewed-profile-role + (root.viewed-profile-banned ? " · Banned" : "");
                        font-size: 12px;
                        color: root.theme-colors[16].value;
                    }

                    if root.viewed-profile-loading : Text {
                        text: "Loading profile...";
                        font-size: 12px;
                        color: root.theme-colors[16].value;
                    }

                    if root.account-role == "Admin" : ComboBox {
                        model: ["Member", "Moderator", "Admin"];
                        current-value: root.viewed-profile-role;
                        selected(value) => {
                            root.set-user-role(root.viewed-profile-username, value);
                        }
                    }

                    if root.account-role == "Admin" && root.viewed-profile-role != "Admin" : Button {
                        text: root.viewed-profile-banned ? "Unban" : "Ban";
                        clicked => {
                            root.set-user-banned(root.viewed-profile-username, !root.viewed-profile-banned);
                        }
                    }

                    if root.account-role == "Moderator" && root.viewed-profile-role == "Member" : Button {
                        text: root.viewed-profile-banned ? "Unban" : "Ban";
                        clicked => {
                            root.set-user-banned(root.viewed-profile-username, !root.viewed-profile-banned);
                        }
                    }

                    if root.privilege-error != "" : Text {
                        text: root.privilege-error;
                        font-size: 11px;
                        color: root.theme-colors[4].value;
                        wrap: word-wrap;
                    }
                }

                Button {
                    text: "Back to chat";
                    clicked => { root.viewed-profile-open = false; }
                }
            }
        }
        
        if !root.viewed-profile-open && root.theme-editor-open : Rectangle {
            background: root.theme-colors[22].value;
            border-radius: 10px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Customize theme";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.theme-colors[13].value;
                }

                Text {
                    text: "Choose your accent and adjust backgrounds and text.";
                    font-size: 13px;
                    color: root.theme-colors[16].value;
                }

                HorizontalBox {
                    height: 42px;
                    spacing: 10px;

                    Text {
                        text: "Preferred accent";
                        width: 140px;
                        color: root.theme-colors[14].value;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        background: root.theme-colors[13].value;
                        border-radius: 4px;
                    }

                    ComboBox {
                        model: ["Lavender", "Blue", "Sapphire", "Teal", "Green", "Yellow", "Peach", "Pink"];
                        current-value: root.accent-name;
                        selected(value) => {
                            root.set-theme-accent(value);
                        }
                    }
                }

                if root.theme-error != "" : Text {
                    text: root.theme-error;
                    font-size: 12px;
                    color: root.theme-colors[4].value;
                }

                ScrollView {
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;

                        for theme-color[index] in root.editable-theme-colors : HorizontalBox {
                            height: 42px;
                            spacing: 10px;

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                background: theme-color.value;
                                border-radius: 4px;
                            }

                            Text {
                                text: theme-color.name;
                                width: 120px;
                                color: root.theme-colors[14].value;
                                vertical-alignment: center;
                            }

                            color-input := LineEdit {
                                text: theme-color.hex;
                                placeholder-text: "#RRGGBB or #RRGGBBAA";
                                accepted(text) => {
                                    root.set-theme-color(index, text);
                                }
                            }
                        }
                    }
                }
            }
        }

        if !root.viewed-profile-open && root.profile-editor-open : Rectangle {
            background: root.theme-colors[22].value;
            border-radius: 10px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Your profile";
                    font-size: 18px;
                    font-weight: 700;
                    color: root.theme-colors[13].value;
                }

                Rectangle {
                    height: 132px;
                    background: root.theme-colors[21].value;
                    border-radius: 8px;
                    clip: true;

                    Image {
                        source: root.profile-banner;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }

                HorizontalBox {
                    height: 86px;
                    spacing: 14px;

                    Rectangle {
                        width: 76px;
                        height: 76px;
                        background: root.theme-colors[21].value;
                        border-radius: 38px;
                        clip: true;

                        Image {
                            source: root.profile-picture;
                            width: parent.width;
                            height: parent.height;
                            image-fit: cover;
                        }
                    }

                    Button {
                        text: "Choose picture";
                        clicked => { root.choose-profile-picture(); }
                    }

                    Button {
                        text: "Choose banner";
                        clicked => { root.choose-profile-banner(); }
                    }
                }

                if root.profile-error != "" : Text {
                    text: root.profile-error;
                    font-size: 12px;
                    color: root.theme-colors[4].value;
                    wrap: word-wrap;
                }
            }
        }

        if !root.theme-editor-open && !root.profile-editor-open : HorizontalBox {
            alignment: stretch;
            cross-axis-self-alignment: stretch;
            horizontal-stretch: 1;
            width: 100%;
            vertical-stretch: 1;
            spacing: 14px;

            Rectangle {
                width: 190px;
                background: root.theme-colors[22].value;
                border-radius: 10px;

                VerticalBox {
                    padding: 10px;
                    spacing: 8px;

                    Text {
                        text: "Channels";
                        font-size: 16px;
                        font-weight: 700;
                        color: root.theme-colors[13].value;
                    }

                    ScrollView {
                        VerticalBox {
                            spacing: 4px;

                            for channel in root.channels : Button {
                                height: 30px;
                                text: "# " + channel.name;
                                primary: channel.id == root.selected-channel-id;
                                clicked => { root.select-channel(channel.name); }
                            }
                        }
                    }
                }
            }

            chat-panel := Rectangle {
                property <bool> follow-chat-bottom: true;
                horizontal-stretch: 1;
                background: root.theme-colors[22].value;
                border-radius: 12px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;
                width: 100%;

                HorizontalBox {
                    spacing: 8px;

                    ComboBox {
                        width: 170px;
                        model: root.channel-names;
                        current-value: root.selected-channel-name;
                        selected(value) => { root.select-channel(value); }
                    }

                    Rectangle { }

                    Text {
                        text: root.selected-channel-topic;
                        color: root.theme-colors[16].value;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.account-role != "Member" : Button {
                        text: root.channel-management-open ? "Close management" : "Manage channels";
                        clicked => { root.channel-management-open = !root.channel-management-open; }
                    }
                }

                if root.account-role != "Member" && root.channel-management-open : Rectangle {
                    background: root.theme-colors[21].value;
                    border-radius: 8px;

                    VerticalBox {
                        padding: 10px;
                        spacing: 8px;

                        Text {
                            text: "Manage channels";
                            color: root.theme-colors[13].value;
                            font-size: 14px;
                            font-weight: 700;
                        }

                        HorizontalBox {
                            spacing: 8px;

                            channel_name_input := LineEdit {
                                width: 160px;
                                placeholder-text: "Channel name";
                                text: root.selected-channel-name;
                            }

                            channel_topic_input := LineEdit {
                                width: 220px;
                                placeholder-text: "Channel topic";
                                text: root.selected-channel-topic;
                            }

                            Button {
                                text: "Save";
                                enabled: root.selected-channel-id != "";
                                clicked => {
                                    root.edit-channel(root.selected-channel-id, channel_name_input.text, channel_topic_input.text);
                                }
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            new_channel_name_input := LineEdit {
                                width: 160px;
                                placeholder-text: "New channel name";
                            }

                            new_channel_topic_input := LineEdit {
                                width: 220px;
                                placeholder-text: "New channel topic";
                            }

                            Button {
                                text: "Create";
                                clicked => {
                                    root.create-channel(new_channel_name_input.text, new_channel_topic_input.text);
                                }
                            }
                        }
                    }
                }

                if root.auth-error != "" : Text {
                    text: root.auth-error;
                    font-size: 12px;
                    color: root.theme-colors[4].value;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: root.theme-colors[24].value;
                    border-radius: 12px;
    
                    chat-scroll := ChatScrollView {
                        scroll-request: root.chat-scroll-request;

                        changed content-height => {
                            if (root.follow-chat-bottom) {
                                chat-scroll.content-y = chat-scroll.content-height;
                            }
                        }

                        changed content-y => {
                            root.follow-chat-bottom = chat-scroll.content-height - chat-scroll.visible-height - chat-scroll.content-y <= 80px;
                        }

                        VerticalBox {
                            padding: 12px;
                            spacing: 10px;
                            alignment: end;
                            
                            if root.messages.length == 0 : Text {
                                text: "No messages yet — say hello!";
                                font-size: 14px;
                                color: root.theme-colors[19].value;
                                horizontal-alignment: center;
                            }
                            
                            for message[index] in root.messages : HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                alignment: message.is-system ? center : (message.author == root.username ? end : start);

                                if message.is-system : Text {
                                    text: message.content;
                                    font-size: 12px;
                                    color: root.theme-colors[19].value;
                                    horizontal-alignment: center;
                                }

                                if !message.is-system && message.author != root.username : Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    background: root.theme-colors[21].value;
                                    border-radius: 19px;
                                    clip: true;

                                    Image {
                                        source: message.profile-picture;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }

                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        clicked => { root.show-user-profile(message.author); }
                                    }
                                }
                                
                                if !message.is-system : Rectangle {
                                    min-width: 64px;
                                    max-width: 700px;
                                    background: message.author == root.username ? root.theme-colors[3].value : root.theme-colors[21].value;
                                    border-radius: 12px;
                                    
                                    VerticalBox {
                                        padding: 10px;
                                        spacing: 3px;
                                        
                                        if message.author != root.username : TouchArea {
                                            height: 16px;
                                            clicked => { root.show-user-profile(message.author); }

                                            Text {
                                                text: message.author;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: root.theme-colors[13].value;
                                            }
                                        }

                                        if message.author == root.username : Text {
                                            text: message.author;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: root.theme-colors[25].value;
                                        }
                                        
                                        Text {
                                            text: message.content;
                                            font-size: 16px;
                                            wrap: word-wrap;
                                            color: message.author == root.username ? root.theme-colors[25].value : root.theme-colors[14].value;
                                        }
                                        
                                        Text {
                                            text: message.timestamp;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                            color: message.author == root.username ? root.theme-colors[25].value : root.theme-colors[16].value;
                                        }
                                    }
                                }

                                if !message.is-system && message.author == root.username : Rectangle {
                                    width: 38px;
                                    height: 38px;
                                    background: root.theme-colors[21].value;
                                    border-radius: 19px;
                                    clip: true;

                                    Image {
                                        source: message.profile-picture;
                                        width: parent.width;
                                        height: parent.height;
                                        image-fit: cover;
                                    }
                                }
                            }
                        }
                    }
                }
                
                Rectangle {
                    background: root.theme-colors[21].value;
                    height: 56px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        
                        input := LineEdit {
                            height: 36px;
                            placeholder-text: "Type a message…";
                            accepted(text) => {
                                root.send-message(text);
                                self.text = "";
                            }
                        }

                        Button {
                            text: "Send";
                            height: 36px;
                            enabled: input.text != "";
                            clicked => {
                                root.send-message(input.text);
                                input.text = "";
                            }
                        }
                    }
                }
            }
            }
        }
    }
}