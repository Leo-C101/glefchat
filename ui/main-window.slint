import { HorizontalBox, VerticalBox, LineEdit, Button, ScrollView } from "std-widgets.slint";
import { CatppuccinMocha } from "theme.slint";

export struct Message {
    content: string,
    timestamp: string,
    author: string,
}

export component MainWindow inherits Window {
    title: "GlefChat";
    width: 1280px;
    height: 780px;
    background: CatppuccinMocha.base;
    
    in-out property <[Message]> messages;
    in-out property <string> nickname: "Me";
    callback send-message(string);
    
    VerticalBox {
        padding: 20px;
        spacing: 16px;
        
        Rectangle {
            background: CatppuccinMocha.surface0;
            height: 60px;
            border-radius: 10px;
            
            HorizontalBox {
                padding-left: 14px;
                padding-right: 14px;
                
                Text {
                    text: "GlefChat";
                    font-size: 22px;
                    font-weight: 700;
                    color: CatppuccinMocha.lavender;
                    vertical-alignment: center;
                }
                
                Rectangle { }
                
                Text {
                    text: "Nickname:";
                    font-size: 14px;
                    color: CatppuccinMocha.subtext0;
                    vertical-alignment: center;
                }
                
                LineEdit {
                    width: 180px;
                    text <=> root.nickname;
                    placeholder-text: "Enter nickname";
                }
            }
        }
        
        Rectangle {
            background: CatppuccinMocha.surface0;
            border-radius: 10px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Rectangle {
                    background: CatppuccinMocha.mantle;
                    border-radius: 10px;
    
                    ScrollView {
                        VerticalBox {
                            padding: 12px;
                            spacing: 10px;
                            alignment: end;
                            
                            if root.messages.length == 0 : Text {
                                text: "No messages yet — say hello!";
                                font-size: 14px;
                                color: CatppuccinMocha.overlay0;
                                horizontal-alignment: center;
                            }
                            
                            for message[index] in root.messages : HorizontalBox {
                                padding: 0px;
                                alignment: message.author == root.nickname ? end : start;
                                
                                Rectangle {
                                    max-width: 700px;
                                    background: message.author == root.nickname ? CatppuccinMocha.mauve : CatppuccinMocha.surface1;
                                    border-radius: 14px;
                                    
                                    VerticalBox {
                                        padding: 10px;
                                        spacing: 3px;
                                        
                                        Text {
                                            text: message.author;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: message.author == root.nickname ? CatppuccinMocha.crust : CatppuccinMocha.lavender;
                                        }
                                        
                                        Text {
                                            text: message.content;
                                            font-size: 16px;
                                            wrap: word-wrap;
                                            color: message.author == root.nickname ? CatppuccinMocha.crust : CatppuccinMocha.text;
                                        }
                                        
                                        Text {
                                            text: message.timestamp;
                                            font-size: 11px;
                                            horizontal-alignment: right;
                                            color: message.author == root.nickname ? CatppuccinMocha.crust : CatppuccinMocha.subtext0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                Rectangle {
                    background: CatppuccinMocha.surface1;
                    height: 52px;
                    border-radius: 10px;

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        
                        input := LineEdit {
                            placeholder-text: "Type a message…";
                            accepted(text) => {
                                root.send-message(text);
                                self.text = "";
                            }
                        }

                        Button {
                            text: "Send";
                            enabled: input.text != "";
                            clicked => {
                                root.send-message(input.text);
                                input.text = "";
                            }
                        }
                    }
                }
            }
        }
    }
}